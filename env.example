# Blockchain Configuration
PRIVATE_KEY=your_private_key_here
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
POLYGON_MAINNET_RPC=https://polygon-rpc.com
GOERLI_RPC=https://goerli.infura.io/v3/YOUR_INFURA_KEY

# API Keys
POLYGONSCAN_API_KEY=your_polygonscan_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# IPFS Configuration
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# External APIs
COINGECKO_API_KEY=your_coingecko_api_key

# Frontend Configuration
NEXT_PUBLIC_NETWORK_ID=80002
NEXT_PUBLIC_CHAIN_NAME=Polygon Amoy Testnet
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com

# Contract Addresses (will be filled after deployment)
NEXT_PUBLIC_NFT_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_NFT_STAKING_ADDRESS=
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=

# WalletConnect Project ID (optional)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id
