# ========================================
# NEXUSVERSE NFT MARKETPLACE
# Environment Configuration
# ========================================

# ========================================
# BLOCKCHAIN CONFIGURATION
# ========================================

# Private key for contract deployment (NEVER commit this!)
PRIVATE_KEY=your_private_key_here

# Polygon Amoy Testnet (Mumbai replacement)
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
POLYGON_AMOY_CHAIN_ID=80002
POLYGON_AMOY_EXPLORER=https://amoy.polygonscan.com

# Polygon Mainnet
POLYGON_MAINNET_RPC=https://polygon-rpc.com
POLYGON_MAINNET_CHAIN_ID=137
POLYGON_MAINNET_EXPLORER=https://polygonscan.com

# Ethereum Mainnet
ETHEREUM_MAINNET_RPC=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETHEREUM_MAINNET_CHAIN_ID=1
ETHEREUM_MAINNET_EXPLORER=https://etherscan.io

# ========================================
# DATABASE CONFIGURATION
# ========================================

# PostgreSQL Database URL
DATABASE_URL="postgresql://username:password@localhost:5432/nexusverse?schema=public"

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ========================================
# IPFS & STORAGE
# ========================================

# Pinata IPFS Service
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Web3.Storage (Alternative to Pinata)
WEB3_STORAGE_TOKEN=your_web3_storage_token

# IPFS Gateway URLs
IPFS_GATEWAY_PRIMARY=https://ipfs.io/ipfs/
IPFS_GATEWAY_FALLBACK=https://gateway.pinata.cloud/ipfs/

# ========================================
# API KEYS & EXTERNAL SERVICES
# ========================================

# CoinGecko API (Crypto prices)
COINGECKO_API_KEY=your_coingecko_api_key

# OpenAI API (AI features)
OPENAI_API_KEY=your_openai_api_key

# Groq API (Alternative AI provider)
GROQ_API_KEY=your_groq_api_key

# Sentry (Error tracking)
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development

# LogRocket (User session recording)
LOGROCKET_APP_ID=your_logrocket_app_id

# ========================================
# AUTHENTICATION & SECURITY
# ========================================

# JWT Secret (Generate a strong random string)
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random

# JWT Expiration (in seconds)
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=604800

# Password Salt Rounds
BCRYPT_SALT_ROUNDS=12

# Session Secret
SESSION_SECRET=your_session_secret_here

# ========================================
# EMAIL & NOTIFICATIONS
# ========================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# SendGrid (Alternative to SMTP)
SENDGRID_API_KEY=your_sendgrid_api_key

# Discord Webhook
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Slack Webhook
SLACK_WEBHOOK_URL=your_slack_webhook_url

# ========================================
# PAYMENT & FINANCIAL
# ========================================

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# ========================================
# MONITORING & ANALYTICS
# ========================================

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# Hotjar
NEXT_PUBLIC_HOTJAR_ID=your_hotjar_id

# ========================================
# SOCIAL & INTEGRATIONS
# ========================================

# Twitter API
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# ========================================
# DEVELOPMENT & TESTING
# ========================================

# Environment
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Backend API URL
API_URL=http://localhost:5000

# Mobile App URL
MOBILE_APP_URL=http://localhost:19006

# Test Database
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/nexusverse_test?schema=public"

# ========================================
# PERFORMANCE & CACHING
# ========================================

# CDN Configuration
CDN_URL=https://cdn.nexusverse.app

# Image Optimization
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true
NEXT_PUBLIC_IMAGE_DOMAINS=ipfs.io,gateway.pinata.cloud,cloudflare-ipfs.com

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ========================================
# FEATURE FLAGS
# ========================================

# Enable/Disable Features
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_SOCIAL_FEATURES=true
NEXT_PUBLIC_ENABLE_STAKING=true
NEXT_PUBLIC_ENABLE_AUCTIONS=true
NEXT_PUBLIC_ENABLE_CHAT=true

# ========================================
# DEPLOYMENT
# ========================================

# Vercel (Frontend)
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TOKEN=your_vercel_token

# Docker Hub
DOCKER_USERNAME=your_docker_username
DOCKER_PASSWORD=your_docker_password

# Kubernetes
KUBECONFIG_PATH=/path/to/your/kubeconfig

# ========================================
# SECURITY & COMPLIANCE
# ========================================

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://nexusverse.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Content Security Policy
CSP_NONCE=your_csp_nonce_here

# ========================================
# BACKUP & RECOVERY
# ========================================

# AWS S3 (Backup storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=nexusverse-backups

# Backup Schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"

# ========================================
# LEGAL & COMPLIANCE
# ========================================

# Terms of Service URL
TERMS_OF_SERVICE_URL=https://nexusverse.app/terms

# Privacy Policy URL
PRIVACY_POLICY_URL=https://nexusverse.app/privacy

# Cookie Policy URL
COOKIE_POLICY_URL=https://nexusverse.app/cookies

# ========================================
# SUPPORT & CONTACT
# ========================================

# Support Email
SUPPORT_EMAIL=support@nexusverse.app

# Contact Form Webhook
CONTACT_WEBHOOK_URL=your_contact_webhook_url

# ========================================
# NOTES
# ========================================

# 1. Copy this file to .env.local
# 2. Fill in your actual values
# 3. NEVER commit .env.local to version control
# 4. Use different values for development, staging, and production
# 5. Regularly rotate sensitive keys and tokens
# 6. Use strong, unique passwords for all services
# 7. Enable 2FA on all accounts where possible
